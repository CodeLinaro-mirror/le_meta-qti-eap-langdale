From c73145deb4bbf35b7a85521560af07491ed0c8cb Mon Sep 17 00:00:00 2001
From: Gustavo Solaira <gustavos@codeaurora.org>
Date: Mon, 5 Nov 2018 13:22:30 -0800
Subject: [PATCH] pci: imx: Increase number of retries for link up

Try to bring the link up for 20 seconds before
failing. This is needed in order to detect hosts
that take longer to initialize.

Signed-off-by: Gustavo Solaira <gustavos@codeaurora.org>
---
 drivers/pci/host/pci-imx6.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/pci/host/pci-imx6.c b/drivers/pci/host/pci-imx6.c
index 5b97e41..e658114 100644
--- a/drivers/pci/host/pci-imx6.c
+++ b/drivers/pci/host/pci-imx6.c
@@ -1177,14 +1177,14 @@ static void imx_pcie_init_phy(struct imx_pcie *imx_pcie)
 
 static int imx_pcie_wait_for_link(struct imx_pcie *imx_pcie)
 {
-	int count = 20000;
+	int count = 200000;
 	struct pcie_port *pp = &imx_pcie->pp;
 	struct device *dev = pp->dev;
 
 	/* check if the link is up or not */
 
 	while (!dw_pcie_link_up(pp)) {
-		udelay(10);
+		udelay(100);
 		if (--count)
 			continue;
 
-- 
1.9.1

